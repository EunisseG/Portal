# =====================================================================
# Variables del entorno Docker (NO son credenciales reales)
# Copia este archivo a .env antes de levantar los contenedores:
#   cp .env.example .env
# =====================================================================

# --- Usuario/grupo del contenedor app (Linux/macOS: usa tu id -u / id -g).
#     En Windows deja 1000/1000. ---
UID=1000
GID=1000

# --- Puertos expuestos en el host (localhost) ---
APP_PORT=8080
DB_PORT=3306
REDIS_PORT=6379

# --- Base de datos (valores de ejemplo para desarrollo local) ---
DB_DATABASE=portal_wortev
DB_USERNAME=wortev
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret

# --- SOLO EN EL SERVIDOR (producción). Déjalas comentadas en tu local. ---
# Combina docker-compose.yml con los ajustes de producción (sin publicar
# MySQL/Redis, nginx solo en 127.0.0.1, sin mailpit, MySQL con memoria limitada).
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Memoria de MySQL: 256M para un servidor de 2 GB, 512M para 4 GB.
# MYSQL_BUFFER_POOL=256M
